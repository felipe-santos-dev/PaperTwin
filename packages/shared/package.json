{
  "name": "@mp1/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tipos e regras de domínio compartilhados entre a API e a web.",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate-process-catalog.ts && tsx scripts/generate-process-relations.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate:java": "tsx scripts/generate-java-assets.ts",
    "generate:api-types": "tsx scripts/generate-api-types.ts",
    "check:api-types": "tsx scripts/generate-api-types.ts --check"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "openapi-typescript": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
