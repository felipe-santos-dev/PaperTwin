# apps/api
PORT=3333
HOST=127.0.0.1
LOG_LEVEL=info

# Postgres. Em dev, deixe vazio para usar PGlite (embutido, sem Docker).
# Em prod/demo, aponte para um Postgres gerenciado.
DATABASE_URL=

# Diretório do PGlite. Vazio mantém o banco em memória, perdido a cada reinício.
PGLITE_DIR=

# Origens autorizadas no CORS, separadas por vírgula.
# Vazio libera qualquer origem — serve em desenvolvimento, não em produção.
# Em produção: https://felipe-santos-dev.github.io
CORS_ORIGINS=

# Aplica migrations e gera a série simulada ao subir.
SEED_ON_BOOT=true

# apps/web
VITE_API_URL=http://127.0.0.1:3333

# Caminho base do site. O GitHub Pages serve em /<repo>/, não na raiz.
VITE_BASE=/
